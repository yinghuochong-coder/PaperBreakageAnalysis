{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperbreak.local/schemas/m6-00-dataset-manifest-v1.schema.json",
  "title": "PaperBreak M6-00 frozen dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetId",
    "datasetVersion",
    "status",
    "createdAtUtc",
    "labelSpecificationVersion",
    "scope",
    "provenance",
    "annotation",
    "splitIndependence",
    "splits",
    "content"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "datasetId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "datasetVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["draft", "frozen", "deprecated"] },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "frozenAtUtc": { "type": ["string", "null"], "format": "date-time" },
    "labelSpecificationVersion": { "const": "1.0.0" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetCameraModels", "pixelFormats", "roiPolicy", "classes"],
      "properties": {
        "targetCameraModels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "pixelFormats": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "roiPolicy": { "type": "string", "minLength": 1 },
        "classes": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["normal_web", "web_break", "non_break_disturbance", "unscorable"] }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pseudonymousSiteIds", "captureStartUtc", "captureEndUtc", "authorizationReference"],
      "properties": {
        "pseudonymousSiteIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "captureStartUtc": { "type": "string", "format": "date-time" },
        "captureEndUtc": { "type": "string", "format": "date-time" },
        "authorizationReference": { "type": "string", "minLength": 1 }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guideVersion", "toolAndVersion", "annotatorCount", "adjudicationPolicy", "completedAtUtc"],
      "properties": {
        "guideVersion": { "const": "1.0.0" },
        "toolAndVersion": { "type": "string", "minLength": 1 },
        "annotatorCount": { "type": "integer", "minimum": 2 },
        "adjudicationPolicy": { "type": "string", "minLength": 1 },
        "completedAtUtc": { "type": "string", "format": "date-time" }
      }
    },
    "splitIndependence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupKeys", "adjacentFramesDisjoint", "duplicateContentDisjoint", "verifiedBy"],
      "properties": {
        "groupKeys": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["production-roll", "capture-session", "physical-event"] }
        },
        "adjacentFramesDisjoint": { "const": true },
        "duplicateContentDisjoint": { "const": true },
        "verifiedBy": { "type": "string", "minLength": 1 }
      }
    },
    "splits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development", "validation", "test"],
      "properties": {
        "development": { "$ref": "#/$defs/split" },
        "validation": { "$ref": "#/$defs/split" },
        "test": { "$ref": "#/$defs/split" }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hashAlgorithm", "rootSha256", "totalFiles", "totalBytes", "storageReference"],
      "properties": {
        "hashAlgorithm": { "const": "SHA-256" },
        "rootSha256": { "$ref": "#/$defs/sha256" },
        "totalFiles": { "type": "integer", "minimum": 1 },
        "totalBytes": { "type": "integer", "minimum": 1 },
        "storageReference": { "type": "string", "minLength": 1 }
      }
    },
    "changeNotes": { "type": "string" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleCount", "positiveEventCount", "negativeCameraHours", "indexReference", "indexSha256"],
      "properties": {
        "sampleCount": { "type": "integer", "minimum": 0 },
        "positiveEventCount": { "type": "integer", "minimum": 0 },
        "negativeCameraHours": { "type": "number", "minimum": 0 },
        "indexReference": { "type": "string", "minLength": 1 },
        "indexSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
