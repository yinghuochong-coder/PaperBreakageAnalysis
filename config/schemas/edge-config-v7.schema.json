{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperbreak.local/schemas/edge-config-v7.schema.json",
  "title": "PaperBreak Edge Configuration v7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "configSchemaVersion", "configRevision", "modifiedAt", "system", "cameras",
    "acquisition", "preview", "algorithm", "event", "storage", "uplink",
    "plantIo", "logging", "health"
  ],
  "properties": {
    "configSchemaVersion": { "const": 7 },
    "configRevision": { "type": "integer", "minimum": 1 },
    "modifiedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "system": { "$ref": "edge-config-v6.schema.json#/properties/system" },
    "cameras": {
      "type": "array", "maxItems": 6,
      "items": { "$ref": "#/$defs/camera" }
    },
    "acquisition": { "$ref": "edge-config-v6.schema.json#/properties/acquisition" },
    "preview": { "$ref": "edge-config-v6.schema.json#/properties/preview" },
    "algorithm": { "$ref": "edge-config-v6.schema.json#/properties/algorithm" },
    "event": { "$ref": "edge-config-v6.schema.json#/properties/event" },
    "storage": { "$ref": "edge-config-v6.schema.json#/properties/storage" },
    "uplink": { "$ref": "edge-config-v6.schema.json#/properties/uplink" },
    "plantIo": { "$ref": "edge-config-v6.schema.json#/properties/plantIo" },
    "logging": { "$ref": "edge-config-v6.schema.json#/properties/logging" },
    "health": { "$ref": "edge-config-v6.schema.json#/properties/health" }
  },
  "$defs": {
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "enabled", "serialNumber", "location", "exposureUs", "autoExposure",
        "gainDb", "frameRate", "roi", "pixelFormat", "triggerMode", "triggerSource",
        "triggerDelayUs", "packetSizeBytes", "interPacketDelayNs", "lineIo"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^CAM0[1-6]$" },
        "enabled": { "type": "boolean" },
        "serialNumber": { "type": "string", "maxLength": 128 },
        "location": { "type": "string", "minLength": 1, "maxLength": 128 },
        "exposureUs": { "type": "number", "minimum": 1, "maximum": 10000000 },
        "autoExposure": { "enum": ["Off", "Once", "Continuous"] },
        "gainDb": { "type": "number", "minimum": -24, "maximum": 48 },
        "frameRate": { "type": "number", "minimum": 0.1, "maximum": 1000 },
        "roi": { "$ref": "edge-config-v4.schema.json#/$defs/roi" },
        "reverseX": { "type": "boolean", "default": false },
        "reverseY": { "type": "boolean", "default": false },
        "pixelFormat": { "enum": ["Mono8", "Mono10", "Mono12", "BayerRG8"] },
        "triggerMode": { "enum": ["Continuous", "Hardware", "Software"] },
        "triggerSource": { "type": "string", "maxLength": 64 },
        "triggerDelayUs": { "type": "integer", "minimum": 0, "maximum": 60000000 },
        "packetSizeBytes": { "type": "integer", "minimum": 576, "maximum": 9000 },
        "interPacketDelayNs": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "lineIo": { "$ref": "edge-config-v4.schema.json#/$defs/lineIo" }
      },
      "allOf": [{
        "if": { "properties": { "enabled": { "const": false } }, "required": ["enabled"] },
        "then": { "properties": { "lineIo": { "properties": {
          "alarmInputEnabled": { "const": false },
          "strobeOutputEnabled": { "const": false }
        } } } }
      }]
    }
  }
}
