{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperbreak.local/schemas/edge-config-v4.schema.json",
  "title": "PaperBreak Edge Configuration v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "configSchemaVersion", "configRevision", "modifiedAt", "system", "cameras",
    "acquisition", "preview", "algorithm", "event", "storage", "uplink",
    "plantIo", "logging", "health"
  ],
  "properties": {
    "configSchemaVersion": { "const": 4 },
    "configRevision": { "type": "integer", "minimum": 1 },
    "modifiedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "system": { "$ref": "#/$defs/system" },
    "cameras": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/camera" } },
    "acquisition": { "$ref": "#/$defs/acquisition" },
    "preview": { "$ref": "#/$defs/preview" },
    "algorithm": { "$ref": "#/$defs/algorithm" },
    "event": { "$ref": "#/$defs/event" },
    "storage": { "$ref": "#/$defs/storage" },
    "uplink": { "$ref": "#/$defs/uplink" },
    "plantIo": { "$ref": "#/$defs/plantIo" },
    "logging": { "$ref": "#/$defs/logging" },
    "health": { "$ref": "#/$defs/health" }
  },
  "$defs": {
    "roi": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height", "offsetX", "offsetY"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "offsetX": { "type": "integer", "minimum": 0, "maximum": 16383 },
        "offsetY": { "type": "integer", "minimum": 0, "maximum": 16383 }
      }
    },
    "algorithmRoi": {
      "anyOf": [
        { "$ref": "#/$defs/roi" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["width", "height", "offsetX", "offsetY"],
          "properties": {
            "width": { "const": 0 },
            "height": { "const": 0 },
            "offsetX": { "const": 0 },
            "offsetY": { "const": 0 }
          }
        }
      ]
    },
    "lineIo": {
      "type": "object", "additionalProperties": false,
      "required": ["alarmInputEnabled", "alarmActiveLevel", "strobeOutputEnabled", "strobeDurationUs", "strobePreDelayUs", "strobePostDelayUs"],
      "properties": {
        "alarmInputEnabled": { "type": "boolean" },
        "alarmActiveLevel": { "enum": ["High", "Low"] },
        "strobeOutputEnabled": { "type": "boolean" },
        "strobeDurationUs": { "type": "integer", "minimum": 0, "maximum": 60000000 },
        "strobePreDelayUs": { "type": "integer", "minimum": 0, "maximum": 60000000 },
        "strobePostDelayUs": { "type": "integer", "minimum": 0, "maximum": 60000000 }
      },
      "allOf": [{
        "if": { "properties": { "strobeOutputEnabled": { "const": true } }, "required": ["strobeOutputEnabled"] },
        "then": { "properties": { "strobeDurationUs": { "minimum": 1 } } }
      }]
    },
    "system": {
      "type": "object", "additionalProperties": false,
      "required": ["machineId", "productionLineId", "shutdownTimeoutMs"],
      "properties": {
        "machineId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "productionLineId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "shutdownTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 }
      }
    },
    "camera": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "enabled", "serialNumber", "location", "exposureUs", "autoExposure", "gainDb", "frameRate", "roi", "pixelFormat", "triggerMode", "triggerSource", "triggerDelayUs", "packetSizeBytes", "interPacketDelayNs", "lineIo"],
      "properties": {
        "id": { "type": "string", "pattern": "^CAM0[1-4]$" },
        "enabled": { "type": "boolean" },
        "serialNumber": { "type": "string", "maxLength": 128 },
        "location": { "type": "string", "minLength": 1, "maxLength": 128 },
        "exposureUs": { "type": "number", "minimum": 1, "maximum": 10000000 },
        "autoExposure": { "enum": ["Off", "Once", "Continuous"] },
        "gainDb": { "type": "number", "minimum": -24, "maximum": 48 },
        "frameRate": { "type": "number", "minimum": 0.1, "maximum": 1000 },
        "roi": { "$ref": "#/$defs/roi" },
        "reverseX": { "type": "boolean", "default": false },
        "reverseY": { "type": "boolean", "default": false },
        "pixelFormat": { "enum": ["Mono8", "Mono10", "Mono12", "BayerRG8"] },
        "triggerMode": { "enum": ["Continuous", "Hardware", "Software"] },
        "triggerSource": { "type": "string", "maxLength": 64 },
        "triggerDelayUs": { "type": "integer", "minimum": 0, "maximum": 60000000 },
        "packetSizeBytes": { "type": "integer", "minimum": 576, "maximum": 9000 },
        "interPacketDelayNs": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "lineIo": { "$ref": "#/$defs/lineIo" }
      },
      "allOf": [{
        "if": { "properties": { "enabled": { "const": false } }, "required": ["enabled"] },
        "then": { "properties": { "lineIo": { "properties": {
          "alarmInputEnabled": { "const": false },
          "strobeOutputEnabled": { "const": false }
        } } } }
      }]
    },
    "acquisition": {
      "type": "object", "additionalProperties": false,
      "required": ["framePoolCapacity", "queueCapacity", "receiveTimeoutMs", "threadPriority"],
      "properties": {
        "autoStart": { "type": "boolean", "default": false },
        "startupRetryIntervalMs": { "type": "integer", "minimum": 1, "maximum": 60000, "default": 1000 },
        "startupRetryCount": { "type": "integer", "minimum": 0, "maximum": 10, "default": 3 },
        "framePoolCapacity": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "queueCapacity": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "receiveTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "threadPriority": { "enum": ["low", "normal", "high"] }
      }
    },
    "preview": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "fps", "maxWidth", "maxHeight", "jpegQuality"],
      "properties": {
        "enabled": { "type": "boolean" }, "fps": { "type": "number", "minimum": 0.1, "maximum": 30 },
        "maxWidth": { "type": "integer", "minimum": 64, "maximum": 8192 },
        "maxHeight": { "type": "integer", "minimum": 64, "maximum": 8192 },
        "jpegQuality": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "algorithm": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "type", "roi", "candidateThreshold", "confirmationThreshold", "consecutiveFrames", "cooldownMs", "modelReference", "modelVersion", "device", "debugOverlay"],
      "properties": {
        "enabled": { "type": "boolean" }, "type": { "type": "string", "minLength": 1, "maxLength": 64 },
        "roi": { "$ref": "#/$defs/algorithmRoi" },
        "candidateThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "confirmationThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "consecutiveFrames": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "cooldownMs": { "type": "integer", "minimum": 0, "maximum": 3600000 },
        "modelReference": { "type": "string", "maxLength": 512 },
        "modelVersion": { "type": "string", "maxLength": 128 },
        "device": { "type": "string", "minLength": 1, "maxLength": 64 },
        "debugOverlay": { "type": "boolean" }
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["preEventSeconds", "postEventSeconds", "maxEventSeconds", "mergeGapSeconds", "keyFrameCount", "saveRaw", "generatePreviewVideo", "uploadPolicy", "retentionDays"],
      "properties": {
        "preEventSeconds": { "type": "integer", "minimum": 0, "maximum": 600 },
        "postEventSeconds": { "type": "integer", "minimum": 0, "maximum": 600 },
        "maxEventSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "mergeGapSeconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "keyFrameCount": { "type": "integer", "minimum": 1, "maximum": 32 },
        "saveRaw": { "type": "boolean" }, "generatePreviewVideo": { "type": "boolean" },
        "uploadPolicy": { "enum": ["never", "confirmed", "all"] },
        "retentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 }
      }
    },
    "storage": {
      "type": "object", "additionalProperties": false,
      "required": ["eventRoot", "cacheRoot", "rollingCacheEnabled", "maximumCacheStorageGiB", "rollingCacheWriteLimitMiBps", "rollingCacheIoTimeoutMs", "warningFreeSpaceGiB", "criticalFreeSpaceGiB", "stopFreeSpaceGiB", "maximumEventStorageGiB"],
      "properties": {
        "eventRoot": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "cacheRoot": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "rollingCacheEnabled": { "type": "boolean" },
        "maximumCacheStorageGiB": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "rollingCacheWriteLimitMiBps": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "rollingCacheIoTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 600000 },
        "warningFreeSpaceGiB": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "criticalFreeSpaceGiB": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "stopFreeSpaceGiB": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maximumEventStorageGiB": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "uplink": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "serverUrl", "heartbeatSeconds", "chunkBytes", "ioTimeoutMs", "uploadLimitMiBps", "credentialReference", "certificateReference"],
      "properties": {
        "enabled": { "type": "boolean" }, "serverUrl": { "type": "string", "maxLength": 2048 },
        "heartbeatSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "chunkBytes": { "type": "integer", "minimum": 65536, "maximum": 4194304 },
        "ioTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "uploadLimitMiBps": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "credentialReference": { "type": "string", "maxLength": 256 },
        "certificateReference": { "type": "string", "maxLength": 256 }
      },
      "allOf": [{
        "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
        "then": {
          "properties": {
            "serverUrl": { "pattern": "^http://" },
            "credentialReference": { "maxLength": 0 },
            "certificateReference": { "maxLength": 0 }
          }
        }
      }]
    },
    "plantIo": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "adapterType", "endpoint", "credentialReference", "pollIntervalMs"],
      "properties": {
        "enabled": { "type": "boolean" }, "adapterType": { "enum": ["disabled", "mock"] },
        "endpoint": { "type": "string", "maxLength": 1024 },
        "credentialReference": { "type": "string", "maxLength": 256 },
        "pollIntervalMs": { "type": "integer", "minimum": 10, "maximum": 60000 }
      }
    },
    "logging": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "directory", "retentionDays", "maximumFileSizeMiB", "maximumFilesPerDay", "queueCapacity"],
      "properties": {
        "level": { "enum": ["trace", "debug", "info", "warning", "error", "critical"] },
        "directory": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "retentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 },
        "maximumFileSizeMiB": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "maximumFilesPerDay": { "type": "integer", "minimum": 1, "maximum": 100 },
        "queueCapacity": { "type": "integer", "minimum": 128, "maximum": 65536 }
      }
    },
    "health": {
      "type": "object", "additionalProperties": false,
      "required": ["sampleIntervalMs", "cpuWarningPercent", "memoryWarningPercent", "droppedFrameWarningRatio", "heartbeatStaleSeconds"],
      "properties": {
        "sampleIntervalMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "cpuWarningPercent": { "type": "number", "minimum": 1, "maximum": 100 },
        "memoryWarningPercent": { "type": "number", "minimum": 1, "maximum": 100 },
        "droppedFrameWarningRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "heartbeatStaleSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    }
  }
}
